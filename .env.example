# Backend API (pg-go). Open the PWA at http://127.0.0.1:5173 so phone auth reCAPTCHA works.
# pg-go CORS_ALLOWED_ORIGINS must include that origin (and http://localhost:5173).
VITE_API_BASE_URL=http://localhost:8080

# Firebase Web App (Project settings > Your apps > Web app)
# Auth → Settings → Authorized domains must include localhost and 127.0.0.1 (no https://, no port).
# Phone + Google providers enabled. Use test phone numbers on Spark; Blaze only for real +91 SMS.
# POST /auth/firebase 503 means pg-go is missing GOOGLE_APPLICATION_CREDENTIALS JSON — restart after adding it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Must match pg-go CASHFREE_ENV (sandbox | production). Used only for Cashfree.js checkout mode.
VITE_CASHFREE_ENV=sandbox
